# Copy to .env and fill in. The .env file is ignored by git and must stay that
# way: a credential on disk is recoverable by rotating it, a credential in the
# history is not.
#
# Load it and run something against the canonical database (ADR-004):
#   powershell -File ./scripts/with-env.ps1 mvn -pl card-service quarkus:dev
#
# sslmode=require is not optional. The connection leaves the machine, and
# without it the driver sends the password in the clear.

DB_URL=jdbc:postgresql://HOST/DATABASE?sslmode=require
DB_USERNAME=USER
DB_PASSWORD=PASSWORD

# Keycloak shares the server, never the schema. The schema must exist first:
#   CREATE SCHEMA IF NOT EXISTS keycloak;
KC_DB_URL=jdbc:postgresql://HOST/DATABASE?sslmode=require&currentSchema=keycloak
KC_DB_USERNAME=USER
KC_DB_PASSWORD=PASSWORD
