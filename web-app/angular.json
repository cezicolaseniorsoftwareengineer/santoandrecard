{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "banco-santo-andre-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [{ "glob": "**/*", "input": "public" }, "src/assets"],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": { "outputHashing": "all", "budgets": [{ "type": "initial", "maximumWarning": "650kB", "maximumError": "900kB" }] },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": { "builder": "@angular/build:dev-server", "configurations": { "production": { "buildTarget": "banco-santo-andre-web:build:production" }, "development": { "buildTarget": "banco-santo-andre-web:build:development" } }, "defaultConfiguration": "development" },
        "test": { "builder": "@angular/build:unit-test", "options": { "tsConfig": "tsconfig.spec.json" } }
      }
    }
  }
}
