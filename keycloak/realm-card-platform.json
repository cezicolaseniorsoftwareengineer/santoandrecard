{
  "realm": "card-platform",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "roles": {
    "realm": [
      { "name": "customer", "description": "Cardholder acting on their own wallet and cards" },
      { "name": "admin", "description": "Issuer operator: card issuance and portfolio administration" },
      {
        "name": "default-roles-card-platform",
        "description": "Granted to every account, including self-registered ones",
        "composite": true,
        "composites": { "realm": ["customer"] }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-card-platform",
    "composite": true,
    "clientRole": false,
    "containerId": "card-platform"
  },
  "clients": [
    {
      "clientId": "card-service",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:4200/*", "http://app.card-platform.localhost/*"],
      "webOrigins": ["http://localhost:4200", "http://app.card-platform.localhost"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "11111111-1111-1111-1111-111111111111",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "customer_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "id",
            "claim.name": "customer_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "44444444-4444-4444-4444-444444444444",
      "username": "santoandreadmin",
      "enabled": true,
      "email": "santoandreadmin@local.invalid",
      "emailVerified": true,
      "requiredActions": [],
      "firstName": "Administracao",
      "lastName": "Santo Andre",
      "credentials": [{ "type": "password", "value": "admin1234", "temporary": false }],
      "realmRoles": ["admin"]
    }
  ]
}
